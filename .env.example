# Twikoo backend used by the original Whalefall blog.
# Keeping this endpoint preserves the existing article and guestbook comments.
PUBLIC_TWIKOO_ENV_ID=https://roaring-sfogliatella-6ea12b.netlify.app/.netlify/functions/twikoo

# Optional: direct image uploads from the local blog workbench to Qiniu Kodo.
# Copy this file to .env, fill the values below, then restart the workbench.
# Keep .env private; it is ignored by Git.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# z0=华东浙江, cn-east-2=华东浙江2, z1=华北, z2=华南, na0=北美, as0=新加坡
QINIU_REGION=z0
IMAGE_CDN_BASE_URL=https://dns.whalefall.top
# Leave empty when images should be stored at the bucket root.
QINIU_PREFIX=
# Optional override, e.g. https://up-z0.qiniup.com
QINIU_UPLOAD_URL=
