---
import BaseLayout from "@/layouts/BaseLayout.astro"
import AboutPage from "@/components/pages/AboutPage"
import { Footer } from "@/components/footer"
import SiteHeader from "@/components/site-header.astro"
import "@/styles/about-page.css"

const title = "关于 | Jiely 的博客"
const description = "保持好奇，学习一切有趣的事物。记录生活，也记录学习。"
---

<BaseLayout {title} {description} fontProfile="interface">
  <link slot="head" rel="preload" as="image" href="/images/home-scrapbook/character-hello.webp" />
  <div class="site-page about-page">
    <SiteHeader />
    <main class="about-page__main" aria-labelledby="about-title">
      <h1 id="about-title" class="sr-only">关于 Jiely</h1>
      <AboutPage client:load />
    </main>
    <Footer />
  </div>
</BaseLayout>
