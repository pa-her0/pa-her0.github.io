---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import { LearningDashboard } from "@/components/learning-dashboard"
import learningProgress from "@/data/learning-progress.json"
import { getSortedPosts } from "@/lib/posts"
import { buildLearningArticles } from "@/lib/learning-articles"
import { normalizeLearningProgress } from "@/lib/learning-progress"
import "@/styles/learning-dashboard.css"

const posts = await getSortedPosts(true)
const articles = buildLearningArticles(posts)
const initialProgress = normalizeLearningProgress(learningProgress)
---

<BaseLayout title="学习进度 | Jiely 的博客" description="牛客、HDU、区域赛 VP、AI Infra 与 Agent 的学习看板、日历和进度记录" fontProfile="interface">
  <div class="site-page learning-page">
    <SiteHeader />
    <main>
      <LearningDashboard {initialProgress} {articles} client:load />
    </main>
    <Footer />
  </div>
</BaseLayout>
