---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import TwikooComments from "@/components/TwikooComments.astro"
---

<BaseLayout title="留言板 | Jiely 的博客" description="欢迎在这里留下想说的话。">
  <div class="min-h-screen bg-background dark:bg-surface-subtle">
    <SiteHeader />
    <main class="mx-auto w-full max-w-4xl px-6 pb-12 pt-28 sm:pt-32">
      <header class="border-b border-border pb-8">
        <p class="text-sm tracking-[0.16em] text-muted-foreground">GUESTBOOK</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">留言板</h1>
        <p class="mt-4 max-w-2xl leading-7 text-muted-foreground">欢迎在这里留下想说的话。</p>
      </header>
      <TwikooComments slug="messages" title="留言板" variant="guestbook" />
    </main>
    <Footer />
  </div>
</BaseLayout>
