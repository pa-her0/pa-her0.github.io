---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import TwikooComments from "@/components/TwikooComments.astro"
---

<BaseLayout title="留言板 | Jiely 的博客" description="欢迎在这里留下想说的话。">
  <div class="site-page bg-background dark:bg-surface-subtle">
    <SiteHeader />
    <main class="mx-auto w-full max-w-4xl px-6 pb-12 pt-28 sm:pt-32">
      <header class="mb-8 max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Jiely / Guestbook</p>
        <h1 class="mt-2 text-3xl font-bold tracking-[-0.035em] sm:text-4xl">留言板</h1>
        <p class="mt-4 leading-7 text-muted-foreground">欢迎在这里留下想说的话。</p>
      </header>
      <TwikooComments slug="messages" title="留言板" variant="guestbook" />
    </main>
    <Footer />
  </div>
</BaseLayout>
