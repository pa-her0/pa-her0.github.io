---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import { StudyDetailView } from "@/components/studies-detail"
import { STUDIES, STUDY_RESOURCES, STUDY_NOTES } from "@/data/studies"

export function getStaticPaths() {
  return STUDIES.map((s) => ({ params: { id: s.id } }))
}

const { id } = Astro.params
const study = STUDIES.find((s) => s.id === id)
if (!study) {
  return Astro.redirect("/studies/")
}

const resources = STUDY_RESOURCES[study.id] ?? []
const notes = STUDY_NOTES[study.id] ?? []

const title = `${study.title} · 专题 | 时歌的博客`
const description = study.epigraph
---

<BaseLayout {title} {description}>
  <div class="min-h-screen bg-background">
    <SiteHeader />
    <main class="pt-20">
      <StudyDetailView client:idle study={study} resources={resources} notes={notes} />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  @media (max-width: 880px) {
    :global(main > .font-sans > main) {
      padding: 32px 20px 0 !important;
    }
    :global(.study-detail-header) {
      padding-bottom: 28px !important;
    }
    :global(.study-resource-row),
    :global(.study-medium-row) {
      grid-template-columns: 48px 1fr !important;
      gap: 18px !important;
    }
    :global(.study-resource-row > .study-resource-status) {
      grid-column: 1 / 3 !important;
      text-align: left !important;
      padding-left: 66px !important;
      padding-top: 4px !important;
    }
    :global(.study-medium-row > div:last-child) {
      grid-column: 1 / 3 !important;
      text-align: left !important;
    }
  }
</style>
