---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Hero } from "@/components/hero"
import { getLatestPublishedPostHref } from "@/lib/posts"
import "@/styles/home-minimal.css"

const title = "Jiely 的博客"
const description = "记录 AI、算法、科研与生活"
const articleHref = await getLatestPublishedPostHref()
---

<BaseLayout {title} {description} fontProfile="interface">
  <link slot="head" rel="preload" href="/brand/jiely-display-v2.png" as="image" />
  <noscript slot="head"><style is:inline>.voxel-playground__fallback { opacity: 0.8 !important; }</style></noscript>
  <div class="jiely-home">
    <SiteHeader minimal />
    <main>
      <Hero {articleHref} client:load />
    </main>
  </div>
</BaseLayout>
