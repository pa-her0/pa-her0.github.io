---
import PostPage from "@/components/pages/PostPage.astro"
import { getLifePosts } from "@/lib/content-sections"
import { getPostsWithNav, type PostEntry } from "@/lib/posts"

export async function getStaticPaths() {
  const posts = getLifePosts(await getPostsWithNav())
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props as { post: PostEntry }
---

<PostPage {post} backHref="/life/" backLabel="返回生活" />
