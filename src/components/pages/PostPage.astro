---
import BaseLayout from "@/layouts/BaseLayout.astro"
import ArticleContent from "@/components/ArticleContent.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"
import Disclaimer from "@/components/Disclaimer.astro"
import PasswordProtection from "@/components/PasswordProtection.astro"
import TwikooComments from "@/components/TwikooComments.astro"
import { getGitModifiedDate } from "@/lib/git-dates"
import { resolvePostUpdatedDate } from "@/lib/post-updated"
import type { PostEntry } from "@/lib/posts"
import bcrypt from "bcryptjs"
import CryptoJS from "crypto-js"

interface Props {
  post: PostEntry
  backHref?: string
  backLabel?: string
}

const { post, backHref = "/articles/", backLabel = "返回博客" } = Astro.props as Props
const { Content, remarkPluginFrontmatter } = await post.render()
const words = remarkPluginFrontmatter?.words
const minutes = remarkPluginFrontmatter?.minutes

const normalizeText = (text: string) => text.replace(/\s+/g, " ").trim()
const buildMetaDescription = (primary: string, fallback: string, articleTitle: string, encrypted: boolean) => {
  const preferred = normalizeText(primary)
  const backup = normalizeText(fallback)
  let result = preferred
  if (!result || result.length < 60) result = backup
  if (!result || result.length < 60) {
    result = encrypted ? `${articleTitle}｜此文章已加密，输入密码后阅读。` : articleTitle
  }
  return result.length > 160 ? result.slice(0, 160) : result
}

const description = buildMetaDescription(
  post.data.description || "",
  remarkPluginFrontmatter?.excerpt || "",
  post.data.title,
  post.data.encrypted ?? false,
)
const title = `${post.data.title} | Jiely 的博客`
const publishedIso = post.data.published ? new Date(post.data.published).toISOString() : ""
const effectiveUpdated = resolvePostUpdatedDate(post.data.published, post.data.updated, getGitModifiedDate(post.id))
const updatedIso = effectiveUpdated.toISOString()
const category = (post.data.category ?? "").toString().trim()
const tags = post.data.tags ?? []
const canonicalUrl = Astro.url.toString()
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  inLanguage: post.data.lang || "zh-CN",
  datePublished: publishedIso || undefined,
  dateModified: updatedIso || publishedIso || undefined,
  mainEntityOfPage: canonicalUrl,
  author: { "@type": "Person", name: "Jiely" },
  publisher: { "@type": "Organization", name: "Jiely 的博客" },
  keywords: tags.length ? tags.join(", ") : undefined,
  articleSection: category || undefined,
}

let encryptedData = null
if (post.data.encrypted && post.data.password) {
  const passwordHash = bcrypt.hashSync(post.data.password, 10)
  const body = typeof post.body === "string" ? post.body : String(post.body || "")
  const encrypted = CryptoJS.AES.encrypt(body, post.data.password).toString()
  encryptedData = { content: encrypted, hash: passwordHash }
}
---

<BaseLayout
  {title}
  {description}
  ogType="article"
  robots={post.data.encrypted ? "noindex, nofollow" : undefined}
>
  <Fragment slot="head">
    {publishedIso ? <meta property="article:published_time" content={publishedIso} /> : null}
    {updatedIso ? <meta property="article:modified_time" content={updatedIso} /> : null}
    {category ? <meta property="article:section" content={category} /> : null}
    {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>
  <div class="site-page bg-background dark:bg-surface-subtle">
    <SiteHeader />
    <ArticleContent post={post} {Content} {words} {minutes} {backHref} {backLabel}>
      <div class="mb-8">
        <Disclaimer disclaimers={post.data.disclaimer} publishedDate={post.data.published} />
      </div>
      {encryptedData ? (
        <div class="mb-6">
          <PasswordProtection encryptedData={encryptedData} slug={post.slug} class="mb-6 rounded-xl" />
          <div id={`article-content-${post.slug}`} class="mb-6 hidden encrypted-content">
            <!-- 内容将在验证密码后动态插入 -->
          </div>
        </div>
      ) : (
        <Content />
      )}
    </ArticleContent>
    <div class="article-comments-shell">
      <div class="article-comments-main">
        <TwikooComments slug={post.data.commentSlug || post.slug} title={post.data.title} />
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>

<style>
  .article-comments-shell {
    display: grid;
    grid-template-columns: minmax(12rem, 14rem) minmax(0, 1fr) minmax(11rem, 13rem);
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    width: min(calc(100% - 2rem), 96rem);
    margin-inline: auto;
    padding-bottom: 3rem;
  }

  .article-comments-main {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1239px) {
    .article-comments-shell {
      grid-template-columns: minmax(0, 55rem) minmax(11rem, 13rem);
      max-width: 76rem;
    }
    .article-comments-main { grid-column: 1; }
  }

  @media (max-width: 900px) {
    .article-comments-shell {
      display: block;
      max-width: 55rem;
    }
  }
</style>
