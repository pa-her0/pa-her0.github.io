---
import { Button } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import friendsData from "@/data/friends.json"
import { ArrowUpRight, ChevronDown, Copy, Mail } from "lucide-react"

const friends = friendsData.flatMap((category) => category.links)

const siteInfo = {
  name: "Jiely 的博客",
  url: "https://www.whalefall.top",
  avatar: "https://www.whalefall.top/avatar.png",
  desc: "In the end, you have to save yourself.",
  rss: "https://www.whalefall.top/rss.xml",
  email: "2799620892@qq.com",
}

const siteInfoText = [
  `昵称：${siteInfo.name}`,
  `地址：${siteInfo.url}`,
  `头像：${siteInfo.avatar}`,
  `描述：${siteInfo.desc}`,
  `RSS：${siteInfo.rss}`,
].join("\n")
---

<ul class="friend-links" role="list">
  {friends.map((friend) => (
    <li>
      <a href={friend.siteurl} target="_blank" rel="noopener noreferrer" class="friend-link">
        <span class="friend-link__avatar" aria-hidden="true">
          {friend.title.trim().slice(0, 1).toUpperCase() || "?"}
          {friend.imgurl && (
            <img src={friend.imgurl} alt="" width="56" height="56" loading="lazy" decoding="async" onerror="this.remove()" />
          )}
        </span>
        <span class="friend-link__copy">
          <strong>{friend.title}</strong>
          <span>{friend.desc?.trim() || "暂无描述"}</span>
        </span>
        <ArrowUpRight className="friend-link__arrow" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>

<details class="friend-exchange">
  <summary>
    <span>申请友链</span>
    <ChevronDown className="friend-exchange__chevron" aria-hidden="true" />
  </summary>
  <div class="friend-exchange__content">
    <Separator />
    <div class="friend-exchange__body">
      <dl class="friend-exchange__info">
        {[
          { label: "站点名称", value: siteInfo.name },
          { label: "站点地址", value: siteInfo.url },
          { label: "站点头像", value: siteInfo.avatar },
          { label: "站点描述", value: siteInfo.desc },
          { label: "RSS", value: siteInfo.rss },
        ].map(({ label, value }) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="friend-exchange__actions">
        <Button type="button" variant="outline" data-copy-friend-info={siteInfoText}>
          <Copy data-icon="inline-start" aria-hidden="true" />
          <span data-copy-status aria-live="polite">复制资料</span>
        </Button>
        <Button asChild>
          <a href={`mailto:${siteInfo.email}`} title={siteInfo.email}>
            <Mail data-icon="inline-start" aria-hidden="true" />
            邮件申请
          </a>
        </Button>
      </div>
    </div>
  </div>
</details>

<script>
  let resetCopyStatus = 0

  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest<HTMLButtonElement>("[data-copy-friend-info]")
    const text = button?.dataset.copyFriendInfo
    const label = button?.querySelector("[data-copy-status]")
    if (!text || !label) return

    try {
      await navigator.clipboard.writeText(text)
      label.textContent = "已复制"
    } catch {
      label.textContent = "复制失败"
    }

    window.clearTimeout(resetCopyStatus)
    resetCopyStatus = window.setTimeout(() => { label.textContent = "复制资料" }, 2000)
  })
</script>

<style>
  .friend-links {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-links > li {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .friend-link,
  .friend-exchange {
    border: 1px solid var(--panel-border);
    border-radius: var(--panel-radius);
    background: var(--panel-background);
  }

  .friend-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .85rem;
    min-height: 6.45rem;
    height: 100%;
    padding: .85rem 1rem;
    color: var(--foreground);
    transition: border-color .2s ease, background-color .2s ease;
  }

  .friend-link:hover {
    border-color: color-mix(in oklab, var(--primary) 36%, var(--border));
    background: var(--paper-warm);
  }

  .friend-link__avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.4rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: .8rem;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .friend-link__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-link__copy {
    display: grid;
    gap: .24rem;
    overflow-wrap: anywhere;
  }

  .friend-link__copy strong {
    font-size: .95rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .friend-link__copy > span {
    color: var(--muted-foreground);
    font-size: .81rem;
    line-height: 1.55;
  }

  .friend-link__arrow {
    align-self: start;
    margin-top: .15rem;
    color: var(--muted-foreground);
    width: 1rem;
    height: 1rem;
  }

  .friend-link:hover .friend-link__arrow {
    color: var(--primary);
  }

  .friend-exchange {
    margin-block-start: .8rem;
  }

  .friend-exchange > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .85rem;
    min-height: 3rem;
    padding: .65rem 1rem;
    border-radius: inherit;
    font-size: .86rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .friend-exchange > summary::-webkit-details-marker {
    display: none;
  }

  .friend-exchange > summary:hover {
    color: var(--primary);
  }

  .friend-link:focus-visible,
  .friend-exchange > summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .friend-exchange__chevron {
    width: 1rem;
    height: 1rem;
    color: var(--muted-foreground);
    transition: transform .2s ease;
  }

  .friend-exchange[open] .friend-exchange__chevron {
    transform: rotate(180deg);
  }

  .friend-exchange__content {
    padding: 0 1rem 1rem;
  }

  .friend-exchange__body {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block-start: 1rem;
  }

  .friend-exchange__info {
    display: grid;
    gap: .42rem;
    margin: 0;
    font-size: .82rem;
    line-height: 1.5;
    min-width: 0;
  }

  .friend-exchange__info > div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: .55rem;
  }

  .friend-exchange__info dt {
    color: var(--muted-foreground);
  }

  .friend-exchange__info dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .friend-exchange__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-link,
    .friend-exchange__chevron { transition: none; }
  }
</style>
