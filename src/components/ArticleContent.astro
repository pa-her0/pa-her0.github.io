---
import type { CollectionEntry } from "astro:content"
import { TableOfContents } from "./table-of-contents"
import ArticleCollectionSidebar from "./ArticleCollectionSidebar.astro"
import { getGitModifiedDate } from "@/lib/git-dates"
import { getLatestPublishedPostHref } from "@/lib/posts"
import "@/styles/article-reading.css"

interface Props {
  post: CollectionEntry<"posts">
  Content?: any
  words?: number
  minutes?: number
}

const { post, Content, words, minutes } = Astro.props as Props
const hasSlot = Astro.slots.has("default")
const data = post.data
const formattedDate = data.published?.toISOString().slice(0, 10)
const weekdayLabel = data.published
  ? new Intl.DateTimeFormat("zh-CN", { weekday: "long" }).format(data.published)
  : ""
const effectiveUpdated = getGitModifiedDate(post.id) ?? data.updated ?? undefined
const formattedUpdated = effectiveUpdated?.toISOString().slice(0, 10)
const showUpdated = formattedUpdated && formattedUpdated !== formattedDate
const tags = data.tags ?? []
const categoryLabel = data.category?.toString().trim() || "未分类"
const groupLabel = data.series?.toString().trim() || categoryLabel
const articleHref = await getLatestPublishedPostHref()
---

<main class="article-reading" data-pagefind-body>
  <div class="article-reading__shell">
    <div class="article-reading__layout">
      <ArticleCollectionSidebar post={post} />

      <div class="article-reading__main">
        <header class="article-reading__header">
          <h1 data-pagefind-meta="title">
            <span>{data.title}</span>
          </h1>

          <div class="article-reading__meta">
            <span class="article-reading__meta-date">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8.5"></circle>
                <path d="M12 7.5v5l3 1.8"></path>
              </svg>
              <time datetime={formattedDate}>{formattedDate}</time>
            </span>
            {weekdayLabel ? <span>{weekdayLabel}</span> : null}
            <i aria-hidden="true">|</i>
            {showUpdated && (
              <span>
                更新
                <time datetime={formattedUpdated}>{formattedUpdated}</time>
              </span>
            )}
            {showUpdated ? <i aria-hidden="true">|</i> : null}
            <span>{groupLabel}</span>
            <i aria-hidden="true">|</i>
            <span>{words ? `${words} 字` : "字数统计中"}</span>
            <span>{minutes ? `${minutes} 分钟阅读` : "阅读时间统计中"}</span>
          </div>
        </header>

        {data.image && (
          <figure class="article-reading__cover" data-bento-motion>
            <img src={data.image} alt={data.title} loading="eager" decoding="async" />
          </figure>
        )}

        <div class="article-reading__toc-mobile">
          <details class="group">
            <summary>
              <span>目录</span>
              <b aria-hidden="true">⌄</b>
            </summary>
            <div class="toc-panel">
              <TableOfContents showHeader={false} client:only="react" />
            </div>
          </details>
        </div>

        <article class="article-reading__prose prose" data-reference-style="bluelanm">
          {hasSlot ? <slot /> : Content ? <Content /> : null}
        </article>

        <footer class="article-reading__footer">
          <div class="article-reading__tags">
            <span>标签</span>
            {tags.length > 0 ? tags.map((tag: string) => (
              <span>#{tag}</span>
            )) : <span>未标签</span>}
            <span>{categoryLabel}</span>
          </div>

          <div class="article-reading__pager">
            <a href={data.prevSlug ? `/posts/${data.prevSlug}/` : articleHref}>
              <small>上一篇</small>
              <span>{data.prevTitle || "浏览更多文章"}</span>
            </a>
            <a href={data.nextSlug ? `/posts/${data.nextSlug}/` : articleHref}>
              <small>下一篇</small>
              <span>{data.nextTitle || "浏览更多文章"}</span>
            </a>
          </div>
        </footer>
      </div>

      <aside class="article-reading__aside" aria-label="文章目录">
        <div class="toc-panel">
          <TableOfContents client:only="react" />
        </div>
      </aside>
    </div>
  </div>
</main>
