---
import 'twikoo/dist/twikoo.css'

interface Props {
  slug: string
  title: string
  variant?: 'article' | 'guestbook'
}

const { slug, title, variant = 'article' } = Astro.props
const envId =
  import.meta.env.PUBLIC_TWIKOO_ENV_ID ||
  'https://roaring-sfogliatella-6ea12b.netlify.app/.netlify/functions/twikoo'
const commentPath =
  slug === 'messages' ? '/messages' : `/posts/${slug.replace(/^\/+|\/+$/g, '')}`
---

<section
  class:list={[
    'pure-twikoo not-prose',
    variant === 'guestbook' && 'pure-twikoo--guestbook',
  ]}
  data-twikoo-comments
  data-env-id={envId}
  data-comment-path={commentPath}
  data-page-title={title}
>
  {variant === 'guestbook' && (
    <section
      class="guestbook-notes"
      data-guestbook-notes
      aria-labelledby="guestbook-notes-title"
      aria-live="polite"
      hidden
    >
      <div class="guestbook-notes__heading">
        <div>
          <p>SELECTED NOTES</p>
          <h2 id="guestbook-notes-title">留言拾光</h2>
        </div>
        <p>从留言板里，摘下几句短短的话。</p>
      </div>
      <div class="guestbook-notes__board">
        <div class="guestbook-notes__grid" data-guestbook-notes-grid></div>
      </div>
    </section>
  )}
  <header class="pure-twikoo__heading">
    <h2 class="pure-twikoo__title">评论</h2>
    <p>欢迎留下你的想法，友善交流。</p>
  </header>
  <div id="tcomment" aria-live="polite"></div>
  <p class="pure-twikoo__error" data-twikoo-error hidden>
    评论区暂时加载失败，请稍后刷新重试。
  </p>
</section>

<script is:inline data-astro-rerun>
  function loadTwikooScript() {
    if (window.twikoo) return Promise.resolve()
    if (window.__twikooLoader) return window.__twikooLoader

    const sources = [
      'https://cdn.jsdelivr.net/npm/twikoo@1.7.15/dist/twikoo.min.js',
      'https://unpkg.com/twikoo@1.7.15/dist/twikoo.min.js',
    ]

    window.__twikooLoader = new Promise((resolve, reject) => {
      const trySource = (index) => {
        if (index >= sources.length) {
          window.__twikooLoader = null
          reject(new Error('Failed to load Twikoo from all configured CDNs'))
          return
        }

        const script = document.createElement('script')
        script.src = sources[index]
        script.async = true
        script.dataset.twikooSdk = 'true'
        script.onload = resolve
        script.onerror = () => {
          script.remove()
          trySource(index + 1)
        }
        document.head.appendChild(script)
      }
      trySource(0)
    })

    return window.__twikooLoader
  }

  function insertEmoji(textarea, emoji) {
    const start = textarea.selectionStart ?? textarea.value.length
    const end = textarea.selectionEnd ?? start
    textarea.value =
      textarea.value.slice(0, start) + emoji + textarea.value.slice(end)
    textarea.selectionStart = textarea.selectionEnd = start + emoji.length
    textarea.dispatchEvent(new Event('input', { bubbles: true }))
    textarea.focus()
  }

  function renderEmojiTokens(root, emojiConfig) {
    const tokenPattern = /:([a-zA-Z0-9_]+)_([a-zA-Z0-9\u4e00-\u9fa5]+):/g
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
    const textNodes = []

    while (walker.nextNode()) textNodes.push(walker.currentNode)

    textNodes.forEach((textNode) => {
      const parent = textNode.parentElement
      if (
        !parent ||
        parent.closest('code, pre, textarea, .doge-emoji-picker')
      ) {
        return
      }

      const text = textNode.textContent || ''
      tokenPattern.lastIndex = 0
      if (!tokenPattern.test(text)) return

      tokenPattern.lastIndex = 0
      const fragment = document.createDocumentFragment()
      let lastIndex = 0
      let match

      while ((match = tokenPattern.exec(text))) {
        const pack = emojiConfig[match[1]]
        const emojiValue = pack?.items?.[match[2]]
        if (!emojiValue) continue

        fragment.append(
          document.createTextNode(text.slice(lastIndex, match.index)),
        )
        if (pack.type === 'image') {
          const image = document.createElement('img')
          image.className = 'doge-comment-emoji'
          image.src = emojiValue
          image.alt = match[2]
          image.title = match[2]
          image.loading = 'lazy'
          image.referrerPolicy = 'no-referrer'
          const size = String(pack.size || 32)
          image.width = Number(size)
          image.height = Number(size)
          fragment.append(image)
        } else {
          fragment.append(document.createTextNode(emojiValue))
        }
        lastIndex = tokenPattern.lastIndex
      }

      if (lastIndex === 0) return
      fragment.append(document.createTextNode(text.slice(lastIndex)))
      textNode.replaceWith(fragment)
    })
  }

  function createEmojiPicker(submit, emojiConfig) {
    const actions = submit.querySelector('.tk-row-actions-start')
    const textarea = submit.querySelector('textarea')
    if (!actions || !textarea || actions.querySelector('[data-doge-emoji]'))
      return

    if (!textarea.placeholder) {
      textarea.placeholder = '既然来了，不妨留下几句话再走吧…'
    }

    actions.classList.add('doge-emoji-actions')

    const trigger = document.createElement('button')
    trigger.type = 'button'
    trigger.className = 'doge-emoji-trigger'
    trigger.dataset.dogeEmoji = 'trigger'
    trigger.setAttribute('aria-label', '打开更多表情')
    trigger.setAttribute('aria-expanded', 'false')
    trigger.textContent = '表情'

    const picker = document.createElement('div')
    picker.className = 'doge-emoji-picker'
    picker.dataset.dogeEmoji = 'picker'
    picker.hidden = true

    const tabs = document.createElement('div')
    tabs.className = 'doge-emoji-tabs'
    const content = document.createElement('div')
    content.className = 'doge-emoji-content'
    picker.append(tabs, content)
    actions.append(trigger, picker)

    const packKeys = Object.keys(emojiConfig)

    function renderPack(packKey) {
      const pack = emojiConfig[packKey]
      if (!pack) return

      content.replaceChildren()
      content.classList.toggle(
        'doge-emoji-content--text',
        pack.type !== 'image',
      )

      Object.entries(pack.items).forEach(([name, value]) => {
        const item = document.createElement('button')
        item.type = 'button'
        item.className = 'doge-emoji-item'
        item.title = name
        item.dataset.emoji =
          pack.type === 'image' ? `:${packKey}_${name}:` : value

        if (pack.type === 'image') {
          const image = document.createElement('img')
          image.src = value
          image.alt = name
          image.loading = 'lazy'
          image.referrerPolicy = 'no-referrer'
          item.append(image)
        } else {
          item.textContent = value
        }
        content.append(item)
      })
    }

    packKeys.forEach((packKey, index) => {
      const pack = emojiConfig[packKey]
      const tab = document.createElement('button')
      tab.type = 'button'
      tab.className = 'doge-emoji-tab'
      tab.dataset.pack = packKey
      tab.textContent = pack.name || packKey
      tab.setAttribute('aria-pressed', String(index === 0))
      tab.addEventListener('click', () => {
        tabs.querySelectorAll('[data-pack]').forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.pack === packKey),
          )
        })
        renderPack(packKey)
      })
      tabs.append(tab)
    })

    if (packKeys[0]) renderPack(packKeys[0])

    content.addEventListener('click', (event) => {
      const item = event.target.closest('[data-emoji]')
      if (!item) return
      insertEmoji(textarea, item.dataset.emoji || '')
      picker.hidden = true
      trigger.setAttribute('aria-expanded', 'false')
    })

    trigger.addEventListener('click', (event) => {
      event.stopPropagation()
      picker.hidden = !picker.hidden
      trigger.setAttribute('aria-expanded', String(!picker.hidden))
    })

    document.addEventListener('click', (event) => {
      if (picker.hidden || picker.contains(event.target)) return
      picker.hidden = true
      trigger.setAttribute('aria-expanded', 'false')
    })
  }

  function refineCommentForm(submit) {
    if (submit.dataset.compactForm === 'true') return
    submit.dataset.compactForm = 'true'

    const fields = {
      nick: ['名称', '必填，用于展示身份'],
      mail: ['邮箱', '必填，用于头像和通知'],
      link: ['网站', '可选，用于引导访问'],
    }

    Object.entries(fields).forEach(([name, values]) => {
      const input = submit.querySelector(`[name="${name}"]`)
      const group = input?.closest('.el-input')
      const label = group?.querySelector('.el-input-group__prepend')
      if (label) label.textContent = values[0]
      if (input) input.placeholder = values[1]
    })

    const textarea = submit.querySelector('textarea')
    if (textarea) {
      textarea.placeholder = '既然来了，不妨留个言再走吧…'
    }

    const markdown = submit.querySelector('.tk-submit-action-icon.__markdown')
    if (markdown) {
      markdown.setAttribute('aria-label', '支持 Markdown')
      markdown.querySelector('svg')?.remove()
    }
  }

  function getGuestbookNoteData(comment) {
    const main = Array.from(comment.children).find((child) =>
      child.classList?.contains('tk-main'),
    )
    const content = main?.querySelector(':scope > .tk-content')
    if (!content) return null

    const text = (content.textContent || '')
      .trim()
      .replace(/^回复\s*@[^:：]+[:：]\s*/, '')
      .replace(/^\s*#+\s*/, '')
      .replace(/\|\|/g, '')
      .replace(/\s+/g, ' ')
      .trim()
    const length = Array.from(text).length

    if (length < 2 || length > 36 || /^[A-Za-z0-9]{16,}$/.test(text)) {
      return null
    }

    const nick =
      main.querySelector(':scope > .tk-row .tk-nick')?.textContent?.trim() ||
      '访客'
    const time = main.querySelector(':scope > .tk-row time')
    const datetime = time?.getAttribute('datetime') || ''
    const fallbackDate = time?.textContent?.trim() || ''

    return {
      id: comment.id || `${nick}-${datetime}-${text}`,
      text,
      nick,
      datetime,
      fallbackDate,
    }
  }

  function formatGuestbookNoteTime(datetime, fallbackDate) {
    const date = new Date(datetime)
    if (!datetime || Number.isNaN(date.getTime())) return fallbackDate

    const pad = (value) => String(value).padStart(2, '0')
    return [
      `${date.getFullYear()}.${pad(date.getMonth() + 1)}.${pad(date.getDate())}`,
      `${pad(date.getHours())}:${pad(date.getMinutes())}`,
    ].join(' · ')
  }

  function createGuestbookNote(data, index) {
    const note = document.createElement('article')
    note.className = 'guestbook-note'
    note.dataset.noteIndex = String(index)

    const fastening = document.createElement('span')
    fastening.className = 'guestbook-note__fastening'
    fastening.setAttribute('aria-hidden', 'true')

    const message = document.createElement('p')
    message.className = 'guestbook-note__message'
    message.textContent = data.text

    const meta = document.createElement('footer')
    meta.className = 'guestbook-note__meta'

    const author = document.createElement('span')
    author.className = 'guestbook-note__author'
    author.textContent = `— ${data.nick}`

    const time = document.createElement('time')
    time.className = 'guestbook-note__time'
    time.dateTime = data.datetime
    time.textContent = formatGuestbookNoteTime(
      data.datetime,
      data.fallbackDate,
    )

    meta.append(author, time)
    note.append(fastening, message, meta)
    return note
  }

  function renderGuestbookNotes(section) {
    const notesSection = section.querySelector('[data-guestbook-notes]')
    const grid = section.querySelector('[data-guestbook-notes-grid]')
    if (!notesSection || !grid) return

    const seen = new Set()
    const notes = Array.from(section.querySelectorAll('.tk-comment'))
      .map(getGuestbookNoteData)
      .filter((note) => {
        if (!note || seen.has(note.id)) return false
        seen.add(note.id)
        return true
      })
      .slice(0, 9)

    if (!notes.length) return

    const signature = notes
      .map((note) => `${note.id}:${note.text}`)
      .join('|')
    if (grid.dataset.notesSignature === signature) return

    grid.dataset.notesSignature = signature
    grid.replaceChildren(
      ...notes.map((note, index) => createGuestbookNote(note, index)),
    )
    notesSection.hidden = false
  }

  function observeGuestbookNotes(section) {
    if (
      !section.querySelector('[data-guestbook-notes]') ||
      section.dataset.guestbookNotesObserved === 'true'
    ) {
      return
    }

    section.dataset.guestbookNotesObserved = 'true'
    let animationFrame = 0
    const update = () => {
      if (animationFrame) return
      animationFrame = window.requestAnimationFrame(() => {
        animationFrame = 0
        renderGuestbookNotes(section)
      })
    }

    update()
    const observer = new MutationObserver(update)
    observer.observe(section, { childList: true, subtree: true })
  }

  async function enhanceTwikooEmojis(section) {
    if (section.dataset.emojiEnhanced === 'true') return
    section.dataset.emojiEnhanced = 'true'

    try {
      const response = await fetch('/emojis.json')
      if (!response.ok) throw new Error(`Emoji config: ${response.status}`)
      const emojiConfig = await response.json()

      const enhance = () => {
        section
          .querySelectorAll('.tk-submit')
          .forEach((submit) => {
            refineCommentForm(submit)
            createEmojiPicker(submit, emojiConfig)
          })
        section
          .querySelectorAll('.tk-content')
          .forEach((content) => renderEmojiTokens(content, emojiConfig))
      }

      enhance()
      const observer = new MutationObserver(enhance)
      observer.observe(section, { childList: true, subtree: true })
    } catch (error) {
      section.dataset.emojiEnhanced = 'false'
      console.error('Emoji library failed to load:', error)
    }
  }

  async function initPureTwikoo(section) {
    if (!section || section.dataset.twikooInitialized === 'true') return

    const error = section.querySelector('[data-twikoo-error]')
    section.dataset.twikooInitialized = 'loading'
    try {
      await loadTwikooScript()
      await window.twikoo.init({
        envId: section.dataset.envId,
        el: '#tcomment',
        path: section.dataset.commentPath,
        lang: 'zh-CN',
      })
      section.dataset.twikooInitialized = 'true'
      observeGuestbookNotes(section)
      await enhanceTwikooEmojis(section)
    } catch (loadError) {
      console.error('Twikoo initialization failed:', loadError)
      section.dataset.twikooInitialized = 'false'
      if (error) error.hidden = false
    }
  }

  function schedulePureTwikoo() {
    const section = document.querySelector('[data-twikoo-comments]')
    if (!section || section.dataset.twikooScheduled === 'true') return
    section.dataset.twikooScheduled = 'true'

    if (!('IntersectionObserver' in window)) {
      void initPureTwikoo(section)
      return
    }

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return
      observer.disconnect()
      void initPureTwikoo(section)
    }, { rootMargin: '700px 0px' })
    observer.observe(section)
  }

  schedulePureTwikoo()
</script>

<style>
  .pure-twikoo {
    --twikoo-theme-color: var(--primary);
    --twikoo-active-text-color: var(--primary);
    width: 100%;
    margin-top: 2.5rem;
    color: var(--foreground);
  }

  .pure-twikoo__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.1rem;
  }

  .pure-twikoo__title {
    margin: 0;
    color: var(--foreground);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pure-twikoo__heading > p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }

  .guestbook-notes {
    margin: 0 0 3.5rem;
  }

  .guestbook-notes[hidden] {
    display: none;
  }

  .guestbook-notes__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.15rem;
  }

  .guestbook-notes__heading > div > p {
    margin: 0 0 0.3rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .guestbook-notes__heading h2 {
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-serif-cn);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .guestbook-notes__heading > p {
    margin: 0 0 0.2rem;
    color: var(--muted-foreground);
    font-size: 0.82rem;
  }

  .guestbook-notes__board {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: calc(var(--radius) * 1.85);
    background:
      radial-gradient(circle at 8% 12%, color-mix(in oklab, #f4b9a8 15%, transparent), transparent 28%),
      radial-gradient(circle at 92% 5%, color-mix(in oklab, #b8dcef 18%, transparent), transparent 28%),
      color-mix(in oklab, var(--muted) 52%, var(--background));
    padding: clamp(1.25rem, 4vw, 2.35rem) clamp(1rem, 3.5vw, 2rem);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 58%, transparent),
      0 20px 52px color-mix(in oklab, var(--foreground) 5%, transparent);
  }

  .guestbook-notes__board::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in oklab, var(--foreground) 3%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--foreground) 3%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    content: '';
    pointer-events: none;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .guestbook-notes__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.25rem);
    align-items: start;
  }

  .guestbook-notes :global(.guestbook-note) {
    --note-background: #e5f4fb;
    --note-rotation: -1.8deg;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 10.4rem;
    flex-direction: column;
    border: 1px solid color-mix(in oklab, #53606a 9%, transparent);
    border-radius: 0.18rem 0.18rem 0.35rem 0.25rem;
    background: var(--note-background);
    padding: 2rem 0.9rem 0.85rem;
    color: #303338;
    box-shadow:
      0 1px 1px rgba(55, 47, 42, 0.07),
      0 10px 18px rgba(63, 56, 52, 0.12);
    transform: rotate(var(--note-rotation));
    transform-origin: 50% 8%;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .guestbook-notes :global(.guestbook-note:nth-child(2n)) {
    --note-background: #fce8e9;
    --note-rotation: 1.4deg;
  }

  .guestbook-notes :global(.guestbook-note:nth-child(3n)) {
    --note-background: #fff3cf;
    --note-rotation: -2.6deg;
  }

  .guestbook-notes :global(.guestbook-note:nth-child(4n)) {
    --note-background: #eee8fb;
    --note-rotation: 2.1deg;
  }

  .guestbook-notes :global(.guestbook-note:nth-child(5n)) {
    --note-background: #e6f4ec;
    --note-rotation: 2.8deg;
  }

  .guestbook-notes :global(.guestbook-note:hover) {
    z-index: 2;
    box-shadow:
      0 2px 2px rgba(55, 47, 42, 0.06),
      0 16px 28px rgba(63, 56, 52, 0.18);
    transform: translateY(-0.28rem) rotate(0deg);
  }

  .guestbook-notes :global(.guestbook-note__fastening) {
    position: absolute;
    top: 0.35rem;
    left: 50%;
    width: 0.85rem;
    height: 0.85rem;
    border: 1px solid rgba(52, 73, 91, 0.16);
    border-radius: 999px;
    background: #598eb0;
    box-shadow:
      inset -0.12rem -0.12rem 0.16rem rgba(25, 51, 68, 0.22),
      0.08rem 0.22rem 0.2rem rgba(49, 55, 58, 0.22);
    transform: translateX(-50%);
  }

  .guestbook-notes :global(.guestbook-note__fastening::after) {
    position: absolute;
    top: 0.72rem;
    left: 50%;
    width: 1px;
    height: 0.7rem;
    background: rgba(65, 75, 82, 0.28);
    content: '';
    transform: translateX(-50%) rotate(7deg);
    transform-origin: top;
  }

  .guestbook-notes :global(.guestbook-note:nth-child(3n + 2) .guestbook-note__fastening) {
    top: -0.18rem;
    width: 2.7rem;
    height: 0.62rem;
    border: 0;
    border-radius: 0.05rem;
    background: rgba(229, 198, 129, 0.62);
    box-shadow: 0 1px 2px rgba(74, 61, 43, 0.12);
    transform: translateX(-50%) rotate(-2deg);
  }

  .guestbook-notes :global(.guestbook-note:nth-child(3n + 2) .guestbook-note__fastening::after) {
    display: none;
  }

  .guestbook-notes :global(.guestbook-note__message) {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-serif-cn);
    font-size: clamp(0.86rem, 1.5vw, 0.98rem);
    line-height: 1.7;
  }

  .guestbook-notes :global(.guestbook-note__meta) {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    margin-top: auto;
    padding-top: 0.85rem;
    color: rgba(48, 51, 56, 0.58);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.45;
  }

  .guestbook-notes :global(.guestbook-note__author) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .guestbook-notes :global(.guestbook-note__time) {
    font-variant-numeric: tabular-nums;
  }

  .pure-twikoo__error {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.3);
    background: color-mix(in oklab, var(--muted) 55%, transparent);
    padding: 0.9rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  :global(.pure-twikoo .tk-comments) {
    color: var(--foreground);
  }

  /* Twikoo 会在运行时注入图标样式；切页期间即使样式尚未恢复，也不要让 SVG 撑满页面。 */
  :global(.pure-twikoo .OwO-logo svg),
  :global(.pure-twikoo .tk-icon svg) {
    display: block;
    width: 1em !important;
    height: 1em !important;
    max-width: 1.25rem;
