---
import type { PostEntry } from "@/lib/posts"
import { getSortedPosts } from "@/lib/posts"
import { getPostSeries } from "@/lib/content-sections"

interface Props {
  post: PostEntry
}

type NavigationGroup = {
  name: string
  posts: PostEntry[]
}

const { post } = Astro.props as Props
const allPosts = (await getSortedPosts(true)).filter((entry) => entry.data.draft !== true)
const grouped = new Map<string, PostEntry[]>()

allPosts.forEach((entry) => {
  const name = getPostSeries(entry)
  grouped.set(name, [...(grouped.get(name) ?? []), entry])
})

const preferredOrder = ["LLM", "开发", "学习", "科研", "算法", "计划", "思考", "生活", "日常", "杂项", "未分类"]
const preferredRank = new Map(preferredOrder.map((name, index) => [name, index]))
const groups: NavigationGroup[] = Array.from(grouped, ([name, posts]) => ({ name, posts })).sort((a, b) => {
  const rankA = preferredRank.get(a.name) ?? preferredOrder.length
  const rankB = preferredRank.get(b.name) ?? preferredOrder.length
  return rankA - rankB || a.name.localeCompare(b.name, "zh-CN")
})

const total = groups.reduce((sum, group) => sum + group.posts.length, 0)
const latestPost = [...allPosts].sort(
  (a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0),
)[0]
const articleHref = latestPost ? `/posts/${latestPost.slug}/` : `/posts/${post.slug}/`
---

<aside class="article-library" aria-label="文章分类导航" data-article-library>
  <div class="article-library__desktop">
    <div class="article-library__scroll" id="article-library-panel">
      <header class="article-library__header">
        <a href={articleHref}>文章</a>
        <span>{total} 篇</span>
      </header>

      <nav class="article-library__groups">
        {groups.map((group) => {
          const isCurrentGroup = group.posts.some((entry) => entry.slug === post.slug)
          return (
            <details open={isCurrentGroup}>
              <summary>
                <span>{group.name}</span>
                <small>{group.posts.length}</small>
                <span class="article-library__chevron" aria-hidden="true">›</span>
              </summary>
              <div class="article-library__articles">
                {group.posts.map((entry) => (
                  <a
                    href={`/posts/${entry.slug}/`}
                    aria-current={entry.slug === post.slug ? "page" : undefined}
                    title={entry.data.title}
                  >
                    {entry.data.title}
                  </a>
                ))}
              </div>
            </details>
          )
        })}
      </nav>
    </div>

    <button
      class="article-library__toggle"
      type="button"
      aria-expanded="true"
      aria-controls="article-library-panel"
      title="收起左侧文章栏"
      data-article-library-toggle
    >
      <span class="article-library__toggle-icon" aria-hidden="true">‹</span>
      <span class="sr-only" data-article-library-label>收起左侧文章栏</span>
    </button>
  </div>

  <details class="article-library__mobile">
    <summary>
      <span>浏览文章</span>
      <b>{total} 篇</b>
    </summary>
    <div class="article-library__mobile-list">
      {groups.map((group) => (
        <section>
          <h2>{group.name}</h2>
          {group.posts.map((entry) => (
            <a href={`/posts/${entry.slug}/`} aria-current={entry.slug === post.slug ? "page" : undefined}>
              {entry.data.title}
            </a>
          ))}
        </section>
      ))}
    </div>
  </details>
</aside>

<script>
  const ARTICLE_LIBRARY_STORAGE_KEY = "article-library-collapsed"

  const initArticleLibraryToggle = () => {
    document.querySelectorAll<HTMLElement>("[data-article-library]").forEach((library) => {
      const button = library.querySelector<HTMLButtonElement>("[data-article-library-toggle]")
      const label = library.querySelector<HTMLElement>("[data-article-library-label]")
      const panel = library.querySelector<HTMLElement>("#article-library-panel")
      const page = library.closest<HTMLElement>(".site-page")
      if (!button || !panel || !page || button.dataset.bound === "true") return

      button.dataset.bound = "true"

      const applyState = (collapsed: boolean) => {
        page.classList.toggle("article-library-is-collapsed", collapsed)
        button.setAttribute("aria-expanded", String(!collapsed))
        button.title = collapsed ? "展开左侧文章栏" : "收起左侧文章栏"
        panel.setAttribute("aria-hidden", String(collapsed))
        panel.toggleAttribute("inert", collapsed)
        if (label) label.textContent = button.title
      }

      let collapsed = false
      try {
        collapsed = localStorage.getItem(ARTICLE_LIBRARY_STORAGE_KEY) === "true"
      } catch {
        collapsed = false
      }
      applyState(collapsed)

      button.addEventListener("click", () => {
        button.classList.remove("is-animating")
        void button.offsetWidth
        button.classList.add("is-animating")
        collapsed = !page.classList.contains("article-library-is-collapsed")
        applyState(collapsed)
        window.setTimeout(() => button.classList.remove("is-animating"), 560)
        try {
          localStorage.setItem(ARTICLE_LIBRARY_STORAGE_KEY, String(collapsed))
        } catch {
          // Private browsing may disable storage; the control still works for this page.
        }
      })
    })
  }

  initArticleLibraryToggle()
  document.addEventListener("astro:page-load", initArticleLibraryToggle)
</script>
