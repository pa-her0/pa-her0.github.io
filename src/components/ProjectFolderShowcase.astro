---
import { ProjectFolder } from '@/components/project-folder'
---

<section class="project-folder-hero" aria-label="项目">
  <h1 class="sr-only">项目</h1>
  <div class="project-folder-hero__word" aria-hidden="true">
    PROJECT<br />ARCHIVE
  </div>
  <ProjectFolder client:load />
</section>

<style>
  .project-folder-hero {
    position: relative;
    min-height: calc(100svh - 5rem);
    overflow: clip;
    isolation: isolate;
    color: var(--foreground);
  }
  .project-folder-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 56%, color-mix(in oklab, var(--primary) 7%, transparent), transparent 52%);
    content: '';
    pointer-events: none;
  }
  .project-folder-hero__word {
    position: absolute;
    top: 54%;
    left: 50%;
    z-index: -1;
    color: transparent;
    font-family: var(--font-sans);
    font-size: clamp(6rem, 17vw, 13rem);
    font-weight: 850;
    line-height: 0.72;
    letter-spacing: -0.09em;
    opacity: 0.07;
    pointer-events: none;
    text-align: center;
    -webkit-text-stroke: 1px var(--foreground);
    transform: translate(-50%, -30%);
    user-select: none;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .project-folder-hero__word { font-size: 6rem; }
  }
</style>
